{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/extraction-report.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","book_id","task_id","run_id","state","entity_mention_count","claim_count","delta_count","evidence_count","semantic_completeness","extraction_hash"],"properties":{"schema_version":{"const":"extraction-report.v1"},"book_id":{"type":"string"},"task_id":{"pattern":"^task_[0-9a-f]{24}$"},"run_id":{"pattern":"^run_[0-9a-f]{24}$"},"state":{"const":"extracted"},"entity_mention_count":{"type":"integer","minimum":0},"claim_count":{"type":"integer","minimum":0},"delta_count":{"type":"integer","minimum":0},"evidence_count":{"type":"integer","minimum":0},"semantic_completeness":{"const":false},"extraction_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}