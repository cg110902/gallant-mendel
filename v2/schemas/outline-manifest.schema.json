{
  "$id": "https://novel-production-os.local/schemas/outline-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "frozen"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved_at": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        "required": [
          "approval"
        ]
      }
    }
  ],
  "properties": {
    "approval": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ]
        },
        "owner": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "owner",
        "approved_at"
      ],
      "type": "object"
    },
    "book_id": {
      "pattern": "^book_[a-z0-9][a-z0-9_-]{0,62}$",
      "type": "string"
    },
    "canon_policy": {
      "enum": [
        "strict",
        "guided",
        "emergent_with_reconcile"
      ]
    },
    "chapter_word_range": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "created_at": {
      "format": "date",
      "type": "string"
    },
    "genre_profile": {
      "minLength": 1,
      "type": "string"
    },
    "language": {
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "type": "string"
    },
    "last_modified_at": {
      "format": "date",
      "type": "string"
    },
    "planned_chapters": {
      "minimum": 1,
      "type": "integer"
    },
    "planned_words": {
      "minimum": 1,
      "type": "integer"
    },
    "point_of_view": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "outline.v1"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "frozen"
      ]
    },
    "tense": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "book_id",
    "title",
    "language",
    "planned_chapters",
    "canon_policy"
  ],
  "title": "Outline Package manifest v1",
  "type": "object"
}
