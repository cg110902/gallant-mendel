{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/run-status.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","task_id","run_id","book_id","state"],"properties":{"schema_version":{"const":"run-status.v1"},"task_id":{"pattern":"^task_[0-9a-f]{24}$"},"run_id":{"pattern":"^run_[0-9a-f]{24}$"},"book_id":{"type":"string"},"state":{"enum":["planned","context_ready","writer_running","writer_failed","draft_ready","aborted","violated","human_review","extraction_ready","needs_rework","extracting","extracted"]},"context_hash":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},"attempt_count":{"type":"integer","minimum":1},"attempt_id":{"type":"string","pattern":"^attempt_[0-9]{3,}$"},"runtime":{"type":"string"},"prose_path":{"const":"prose.md"},"prose_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"error":{"type":["string","null"]},"authority_sentinel_before":{"$ref":"#/$defs/sentinel"},"authority_sentinel_after":{"$ref":"#/$defs/sentinel"},"review_count":{"type":"integer","minimum":1},"review_id":{"type":"string","pattern":"^review_[0-9]{3,}$"},"review_prose_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"review_decision":{"enum":["approve","rework"]},"review_actor":{"type":"string","minLength":1,"maxLength":128},"extraction_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"$defs":{"sentinel":{"type":"object","additionalProperties":{"type":["string","null"]}}}}