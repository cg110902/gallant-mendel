{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-production-os.local/schemas/ide-live-attestation-input.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "vendor", "ide_version", "os", "executed_at", "operator", "operator_attestation", "checks"],
  "properties": {
    "schema_version": {"const": "ide-live-attestation-input.v1"},
    "vendor": {"const": "antigravity"},
    "ide_version": {"type": "string", "minLength": 1},
    "os": {"type": "string", "minLength": 1},
    "executed_at": {"type": "string"},
    "operator": {"type": "string", "minLength": 1},
    "operator_attestation": {"type": "string"},
    "checks": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pending", "pass", "fail"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "template_hash": {"type": "string"}
  },
  "additionalProperties": false
}
