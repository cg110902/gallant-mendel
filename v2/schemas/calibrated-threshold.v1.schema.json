{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/calibrated-threshold.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","metric","value","severity","calibrated_at","sample_size","distribution","rationale","owner","expires_at","corpus_hash","calibration_report_hash"],"properties":{"schema_version":{"const":"calibrated-threshold.v1"},"metric":{"type":"string"},"value":{"type":"number"},"severity":{"enum":["info","warning","hard"]},"calibrated_at":{"type":"string","format":"date-time"},"sample_size":{"type":"integer","minimum":1},"distribution":{"type":"object","additionalProperties":false,"required":["p50","p90","p99"],"properties":{"p50":{"type":"number"},"p90":{"type":"number"},"p99":{"type":"number"}}},"rationale":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"expires_at":{"type":"string","format":"date-time"},"corpus_hash":{"$ref":"#/$defs/hash"},"calibration_report_hash":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}