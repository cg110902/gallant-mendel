{
  "$id": "https://novel-production-os.local/schemas/obligation-state.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future Obligation State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schema_version", "book_id", "branch_id", "cutoff", "status_filter", "obligations", "active_count", "terminal_count", "due_count", "overdue_count", "obligation_hash"],
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": "obligation-state.v1"},
    "book_id": {"type": "string", "pattern": "^book_[a-z0-9][a-z0-9_-]{0,62}$"},
    "branch_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "cutoff": {"type": "object", "additionalProperties": false, "required": ["selector", "event_id", "lineage_index", "story_seq"], "properties": {"selector": {"type": "string"}, "event_id": {"type": "string", "pattern": "^event_[0-9a-f]{32}$"}, "lineage_index": {"type": "integer", "minimum": 1}, "story_seq": {"type": "integer", "minimum": 0}}},
    "status_filter": {"type": ["string", "null"], "enum": [null, "open", "touched", "deferred", "fulfilled", "subverted", "retired", "active", "terminal", "due", "overdue"]},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "active_count": {"type": "integer", "minimum": 0},
    "terminal_count": {"type": "integer", "minimum": 0},
    "due_count": {"type": "integer", "minimum": 0},
    "overdue_count": {"type": "integer", "minimum": 0},
    "obligation_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "window": {"type": "object", "additionalProperties": false, "required": ["earliest", "latest"], "properties": {"earliest": {"type": "integer", "minimum": 1}, "latest": {"type": "integer", "minimum": 1}}},
    "obligation": {
      "type": "object", "additionalProperties": false,
      "required": ["obligation_id", "kind", "owner_id", "created_at_story_seq", "expected_window", "weight", "status", "last_touched_seq", "payoff_event_id", "allowed_resolution", "reader_visibility", "evidence_requirement", "source_refs", "clue_count", "touch_count", "defer_count", "created_event", "schedule_state"],
      "properties": {
        "obligation_id": {"type": "string", "pattern": "^ob_[A-Za-z0-9_-]+$"},
        "kind": {"type": "string", "minLength": 1}, "owner_id": {"type": "string", "minLength": 1},
        "created_at_story_seq": {"type": "integer", "minimum": 0}, "expected_window": {"$ref": "#/$defs/window"},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["open", "touched", "deferred", "fulfilled", "subverted", "retired"]},
        "last_touched_seq": {"type": ["integer", "null"], "minimum": 0},
        "payoff_event_id": {"type": ["string", "null"], "pattern": "^event_[0-9a-f]{32}$"},
        "allowed_resolution": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fulfilled", "subverted", "deferred", "retired"]}},
        "reader_visibility": {"type": "string", "minLength": 1},
        "evidence_requirement": {"type": "object", "additionalProperties": false, "required": ["min_clues", "payoff_requires"], "properties": {"min_clues": {"type": "integer", "minimum": 1}, "payoff_requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "clue_count": {"type": "integer", "minimum": 0}, "touch_count": {"type": "integer", "minimum": 0}, "defer_count": {"type": "integer", "minimum": 0},
        "created_event": {"type": "string", "pattern": "^event_[0-9a-f]{32}$"},
        "schedule_state": {"enum": ["scheduled", "due", "overdue", "closed"]}
      }
    }
  }
}
