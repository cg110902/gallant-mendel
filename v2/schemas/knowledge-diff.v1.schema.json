{
  "$id": "https://novel-production-os.local/schemas/knowledge-diff.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Boundary Diff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "schema_version", "book_id", "branch_id", "cutoff", "valid_at", "holder_id", "holder_edges", "reader_edges", "reader_only", "holder_only", "shared", "hidden_truth", "known_false_or_disputed", "knowledge_hash"],
  "properties": {
    "ok": {"const": true},
    "schema_version": {"const": "knowledge-diff.v1"},
    "book_id": {"type": "string", "pattern": "^book_[a-z0-9][a-z0-9_-]{0,62}$"},
    "branch_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "event_id", "lineage_index", "story_seq"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "pattern": "^event_[0-9a-f]{32}$"},
        "lineage_index": {"type": "integer", "minimum": 1},
        "story_seq": {"type": "integer", "minimum": 0}
      }
    },
    "valid_at": {"type": ["string", "null"], "pattern": "^story:.+$"},
    "holder_id": {"type": "string", "minLength": 1, "not": {"const": "_reader"}},
    "holder_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "reader_edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "reader_only": {"$ref": "#/$defs/factIds"},
    "holder_only": {"$ref": "#/$defs/factIds"},
    "shared": {"$ref": "#/$defs/factIds"},
    "hidden_truth": {"$ref": "#/$defs/factIds"},
    "known_false_or_disputed": {"$ref": "#/$defs/factIds"},
    "knowledge_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "factIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^fact_[A-Za-z0-9_-]+$"}
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder_id", "knowledge_id", "state", "confidence", "source_refs", "source_event_id", "granted_event", "known_at_seq"],
      "properties": {
        "holder_id": {"type": "string", "minLength": 1},
        "knowledge_id": {"type": "string", "pattern": "^fact_[A-Za-z0-9_-]+$"},
        "state": {"enum": ["suspected", "believed", "confirmed", "false_belief", "clue", "misled"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_event_id": {"type": ["string", "null"], "pattern": "^event_[0-9a-f]{32}$"},
        "granted_event": {"type": "string", "pattern": "^event_[0-9a-f]{32}$"},
        "known_at_seq": {"type": "integer", "minimum": 0}
      }
    }
  }
}
