{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/human-decision.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","run_id","review_id","decision","actor","note","context_hash","prose_hash"],"properties":{"schema_version":{"const":"human-decision.v1"},"run_id":{"pattern":"^run_[0-9a-f]{24}$"},"review_id":{"pattern":"^review_[0-9]{3,}$"},"decision":{"enum":["approve","rework"]},"actor":{"type":"string","minLength":1,"maxLength":128},"note":{"type":"string","maxLength":2000},"context_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"prose_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}