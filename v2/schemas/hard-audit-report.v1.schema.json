{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/hard-audit-report.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","book_id","task_id","run_id","chapter_id","context_hash","extraction_hash","reconcile_hash","state","findings","counts","has_hard_violation","requires_human_review","audit_hash"],"properties":{"schema_version":{"const":"hard-audit-report.v1"},"book_id":{"type":"string"},"task_id":{"type":"string"},"run_id":{"type":"string"},"chapter_id":{"type":"string"},"context_hash":{"$ref":"#/$defs/hash"},"extraction_hash":{"$ref":"#/$defs/hash"},"reconcile_hash":{"$ref":"#/$defs/hash"},"state":{"enum":["audit_passed","audit_review","audit_failed"]},"findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["finding_id","rule_id","severity","item_id","claim_id","evidence_ids","message"],"properties":{"finding_id":{"pattern":"^finding_[0-9a-f]{24}$"},"rule_id":{"type":"string"},"severity":{"enum":["hard","review"]},"item_id":{"type":["string","null"]},"claim_id":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}},"message":{"type":"string"}}}},"counts":{"type":"object","additionalProperties":false,"required":["hard","review"],"properties":{"hard":{"type":"integer","minimum":0},"review":{"type":"integer","minimum":0}}},"has_hard_violation":{"type":"boolean"},"requires_human_review":{"type":"boolean"},"audit_hash":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}