{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/candidate-claims.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","book_id","run_id","chapter_id","context_hash","prose_hash","semantic_completeness","entity_mentions","claims"],"properties":{"schema_version":{"const":"candidate-claims.v1"},"book_id":{"type":"string"},"run_id":{"pattern":"^run_[0-9a-f]{24}$"},"chapter_id":{"type":"string"},"context_hash":{"$ref":"#/$defs/hash"},"prose_hash":{"$ref":"#/$defs/hash"},"semantic_completeness":{"const":false},"entity_mentions":{"type":"array","items":{"$ref":"#/$defs/mention"}},"claims":{"type":"array","items":{"$ref":"#/$defs/claim"}}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"mention":{"type":"object","additionalProperties":false,"required":["mention_id","evidence_id","object_id","surface","start_char","end_char"],"properties":{"mention_id":{"pattern":"^mention_[0-9a-f]{24}$"},"evidence_id":{"pattern":"^evidence_[0-9a-f]{24}$"},"object_id":{"type":"string"},"surface":{"type":"string"},"start_char":{"type":"integer","minimum":0},"end_char":{"type":"integer","minimum":1}}},"claim":{"type":"object","additionalProperties":false,"required":["claim_id","claim_kind","confidence","evidence_ids","subject_id","predicate","value"],"properties":{"claim_id":{"pattern":"^claim_[0-9a-f]{24}$"},"claim_kind":{"const":"fact"},"confidence":{"const":"candidate"},"evidence_ids":{"type":"array","minItems":1,"items":{"pattern":"^evidence_[0-9a-f]{24}$"}},"subject_id":{"type":"string"},"predicate":{"pattern":"^[a-z][a-z0-9_]{0,63}$"},"value":{}}}}}