{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/branch-operation-report.v1.schema.json","type":"object","required":["ok","schema_version","book_id","branch_id","source_branch","fork_event_id","marker_event_id","mode","main_head_unchanged","report_hash"],"properties":{"ok":{"const":true},"schema_version":{"const":"branch-operation-report.v1"},"book_id":{"type":"string","minLength":1},"branch_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"source_branch":{"type":"string"},"fork_event_id":{"type":"string","pattern":"^event_[0-9a-f]{32}$"},"marker_event_id":{"type":"string","pattern":"^event_[0-9a-f]{32}$"},"mode":{"enum":["fork","non_destructive_rollback"]},"main_head_unchanged":{"const":true},"report_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}},"additionalProperties":false}
