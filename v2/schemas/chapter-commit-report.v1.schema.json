{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/chapter-commit-report.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","book_id","task_id","run_id","chapter_id","state","event_ids","commit_head","chapter_path","chapter_hash","projection_state_hash","commit_hash"],"properties":{"schema_version":{"const":"chapter-commit-report.v1"},"book_id":{"type":"string"},"task_id":{"type":"string"},"run_id":{"type":"string"},"chapter_id":{"type":"string"},"state":{"const":"published"},"event_ids":{"type":"array","minItems":4,"items":{"pattern":"^event_[0-9a-f]{32}$"}},"commit_head":{"pattern":"^event_[0-9a-f]{32}$"},"chapter_path":{"type":"string"},"chapter_hash":{"$ref":"#/$defs/hash"},"projection_state_hash":{"$ref":"#/$defs/hash"},"commit_hash":{"$ref":"#/$defs/hash"}},"$defs":{"hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}