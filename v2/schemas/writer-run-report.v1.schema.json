{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://novel-production-os.local/schemas/writer-run-report.v1.schema.json","type":"object","additionalProperties":false,"required":["ok","schema_version","book_id","task_id","run_id","state","attempt_id","runtime","prose_path","prose_hash"],"properties":{"ok":{"type":"boolean"},"schema_version":{"const":"writer-run-report.v1"},"book_id":{"type":"string"},"task_id":{"pattern":"^task_[0-9a-f]{24}$"},"run_id":{"pattern":"^run_[0-9a-f]{24}$"},"state":{"enum":["context_ready","writer_running","writer_failed","draft_ready","aborted","violated","human_review","extraction_ready","needs_rework"]},"attempt_id":{"type":["string","null"],"pattern":"^attempt_[0-9]{3,}$"},"runtime":{"type":["string","null"]},"prose_path":{"type":["string","null"]},"prose_hash":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"}}}